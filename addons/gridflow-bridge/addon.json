{
  "id": "gridflow-bridge",
  "name": "GridFlow Data Bridge",
  "version": "1.0.0",
  "description": "Streams DroidGrid camera data to external GridFlow pipelines. Supports frame forwarding, metadata export, and event-driven data transformation via configurable converters.",
  "author": "Vision-Orchestration",
  "entry": "index.ts",
  "permissions": ["cameras.read", "recording.events", "api.register", "ui.panel"],
  "config": {
    "endpoint":       { "type": "string",  "default": "http://localhost:8100", "description": "GridFlow service base URL" },
    "api_key":        { "type": "string",  "default": "", "description": "API key for GridFlow authentication" },
    "stream_mode":    { "type": "string",  "default": "metadata", "enum": ["metadata", "frames", "events"], "description": "What to stream to GridFlow" },
    "batch_interval": { "type": "number",  "default": 5, "description": "Seconds between batch uploads" },
    "auto_sync":      { "type": "boolean", "default": true, "description": "Auto-sync camera list on change" },
    "export_format":  { "type": "string",  "default": "json", "enum": ["json", "csv", "parquet"], "description": "Export format for data files" }
  },
  "ui": {
    "panel": true,
    "settings": true
  }
}
