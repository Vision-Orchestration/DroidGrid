{
  "name": "droidgrid-pro",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev":            "tsx server.ts",
    "start":          "tsx server.ts",
    "build":          "vite build",
    "preview":        "vite preview",
    "electron:dev":   "concurrently \"npm run dev\" \"wait-on http://localhost:3000/api/health && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "clean":          "rm -rf dist"
  },
  "build": {
    "appId":       "com.vision-orchestration.droidgrid",
    "productName": "DroidGrid Pro",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron-main.cjs", "server.ts", "package.json"],
    "win": { "target": "portable" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "express":             "^4.21.2",
    "lucide-react":        "^0.546.0",
    "motion":              "^12.23.24",
    "react":               "^19.0.1",
    "react-dom":           "^19.0.1",
    "vite":                "^6.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite":  "^4.1.14",
    "@types/express":     "^4.17.21",
    "@types/node":        "^22.14.0",
    "concurrently":       "^9.1.2",
    "electron":           "^33.0.0",
    "electron-builder":   "^25.1.8",
    "tailwindcss":        "^4.1.14",
    "tsx":                "^4.21.0",
    "typescript":         "~5.8.2",
    "wait-on":            "^8.0.1"
  }
}
